---
import { useTranslations } from "@i18n/utils";
import type { LocaleCode } from "@config/locales";

export interface Props {
  headings: {
    depth: number;
    text: string;
    slug: string;
  }[];
  lang: LocaleCode;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang);

// Improved heading processing to support nesting
const processHeadings = (headings) => {
  const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
  const result = [];
  let currentH2 = null;

  filtered.forEach((h) => {
    if (h.depth === 2) {
      currentH2 = { ...h, children: [] };
      result.push(currentH2);
    } else if (h.depth === 3 && currentH2) {
      currentH2.children.push(h);
    }
  });

  return result;
};

const tocTree = processHeadings(headings);
---

{
  tocTree.length > 0 && (
    <aside class="floating-toc" aria-label="Table of contents">
      <div class="floating-toc__inner">
        <div class="floating-toc__header">{t("ui.contents")}</div>
        <nav class="floating-toc__nav">
          <ol class="toc-list">
            {tocTree.map((h2) => (
              <li class="toc-item">
                <a
                  href={`#${h2.slug}`}
                  class="floating-toc__link depth-2"
                  data-level="2"
                >
                  <div class="floating-toc__text">{h2.text}</div>
                </a>
                {h2.children.length > 0 && (
                  <ol class="toc-sublist">
                    {h2.children.map((h3) => (
                      <li class="toc-subitem">
                        <a
                          href={`#${h3.slug}`}
                          class="floating-toc__link depth-3"
                          data-level="3"
                        >
                          <div class="floating-toc__text">{h3.text}</div>
                        </a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </aside>
  )
}

<style>
  @media (max-width: 1400px) {
    .floating-toc {
      display: none;
    }
  }

  .floating-toc {
    position: fixed;
    top: 50%;
    right: 2rem;
    transform: translateY(-50%);
    width: 260px;
    max-height: 70vh;
    z-index: 10;
    animation: fadeIn 0.3s ease-out;
  }

  .floating-toc__inner {
    padding: 1.5rem;
    overflow-y: auto;
    max-height: 70vh;
    scrollbar-width: thin;
    scrollbar-color: var(--border-color) transparent;

    /* Frosted glass effect */
    background-color: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 16px;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  :global(html.dark-mode) .floating-toc__inner {
    background-color: rgba(40, 40, 40, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .floating-toc__inner::-webkit-scrollbar {
    width: 4px;
  }

  .floating-toc__inner::-webkit-scrollbar-track {
    background: transparent;
  }

  .floating-toc__inner::-webkit-scrollbar-thumb {
    background-color: var(--border-color);
    border-radius: 2px;
  }

  .floating-toc__header {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--main-color);
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .floating-toc__nav {
    font-size: 0.9rem;
  }

  /* Reset for counters */
  .toc-list {
    list-style: none;
    counter-reset: item;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    counter-increment: item;
    margin-bottom: 0.25rem;
  }

  .toc-sublist {
    list-style: none;
    counter-reset: subitem;
    padding-left: 0.5rem;
    margin-top: 0.25rem;
  }

  .toc-subitem {
    counter-increment: subitem;
  }

  .floating-toc__link {
    display: flex;
    align-items: baseline;
    padding: 0.4rem 0.5rem;
    color: var(--text-color);
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s ease;
    line-height: 1.4;
    position: relative;
  }

  /* Numbering logic */
  .floating-toc__link.depth-2::before {
    content: counter(item) ". ";
    font-weight: 600;
    margin-right: 0.4em;
    font-variant-numeric: tabular-nums;
    color: var(--main-color);
    opacity: 0.7;
    flex-shrink: 0;
  }

  .floating-toc__link.depth-3::before {
    content: counter(item) "." counter(subitem) " ";
    font-size: 0.9em;
    margin-right: 0.4em;
    font-variant-numeric: tabular-nums;
    color: var(--text-color);
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* Indent adjustments */
  .floating-toc__link.depth-3 {
    padding-left: 1.25rem;
    font-size: 0.85rem;
  }

  .floating-toc__link:hover {
    color: var(--main-color);
    background-color: rgba(0, 0, 0, 0.04);
  }

  :global(html.dark-mode) .floating-toc__link:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  .floating-toc__link.active {
    color: var(--main-color);
    background-color: var(--active-tab-bg);
    font-weight: 500;
  }

  .floating-toc__link.active::before {
    color: var(--highlight-color);
    opacity: 1;
  }

  .floating-toc__text {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media (min-width: 1600px) {
    .floating-toc {
      right: max(2rem, calc((100vw - 1200px) / 2 - 320px));
      width: 300px;
    }
  }

  @media (min-width: 1920px) {
    .floating-toc {
      right: calc((100vw - 1200px) / 2 - 360px);
      width: 320px;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-50%) translateX(10px);
    }
    to {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toc = document.querySelector(".floating-toc");
    if (!toc) {
      return;
    }

    const links = Array.from(toc.querySelectorAll(".floating-toc__link"));
    const headings = links
      .map((link) => {
        const id = link.getAttribute("href")?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean);

    const scrollToHeading = (targetId) => {
      const targetElement = document.getElementById(targetId);
      if (!targetElement) {
        return;
      }

      const offset = 100;
      const targetPosition = targetElement.offsetTop - offset;
      window.scrollTo({ top: targetPosition, behavior: "smooth" });
      history.pushState(null, "", `#${targetId}`);
    };

    links.forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        const targetId = link.getAttribute("href")?.slice(1);
        if (targetId) {
          scrollToHeading(targetId);
        }
      });
    });

    const observerOptions = {
      rootMargin: "-100px 0px -70% 0px",
      threshold: 0,
    };

    const activeClass = "active";
    let currentActiveLink = null;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute("id");
        const correspondingLink = id
          ? toc.querySelector(`.floating-toc__link[href="#${id}"]`)
          : null;

        if (entry.isIntersecting && correspondingLink) {
          if (currentActiveLink && currentActiveLink !== correspondingLink) {
            currentActiveLink.classList.remove(activeClass);
          }

          correspondingLink.classList.add(activeClass);
          currentActiveLink = correspondingLink;
        }
      });
    }, observerOptions);

    headings.forEach((heading) => {
      if (heading) {
        observer.observe(heading);
      }
    });

    const setInitialActive = () => {
      const scrollPosition = window.scrollY + 150;
      for (let index = headings.length - 1; index >= 0; index -= 1) {
        const heading = headings[index];
        const link = links[index];
        if (heading && link && scrollPosition >= heading.offsetTop) {
          link.classList.add(activeClass);
          currentActiveLink = link;
          break;
        }
      }
    };

    setInitialActive();
  });
</script>
