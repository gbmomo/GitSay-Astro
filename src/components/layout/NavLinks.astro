---
type NavItem = {
  id: string;
  href: string;
  label: string;
};

interface NavLinksProps {
  navItems: NavItem[];
  variant?: "desktop" | "mobile";
}

const { navItems, variant = "desktop" }: NavLinksProps = Astro.props;
const isMobile = variant === "mobile";
---

{
  isMobile
    ? navItems.map(({ id, href, label }) => (
        <a href={href} class="mobile-menu__link" data-nav-item={id}>
          {label}
        </a>
      ))
    : navItems.map(({ id, href, label }) => (
        <a
          href={href}
          class="header__nav-btn header__link header__link--desktop"
          data-nav-item={id}
        >
          <span class="header__btn-icon">{id === "about" ? "ℹ️" : ""}</span>
          <span class="header__btn-text">{label}</span>
        </a>
      ))
}
